source "https://rubygems.org"

# These match the versions pinned by github-pages 232 (the gems GitHub Pages
# builds with). The github-pages meta-gem itself is not used because it pins
# jekyll-remote-theme 0.4.3, which caps rubyzip below 3.0 and blocks the fix
# for GHSA-47m2-wp7j-p9vc. This site does not use remote themes.
gem 'jekyll', '3.10.0'
gem 'jemoji', '0.13.0'
gem 'kramdown', '2.4.0'
gem 'kramdown-parser-gfm', '1.1.0'
gem 'rouge', '3.30.0'
gem 'liquid', '4.0.4'
gem 'webrick', '~> 1.8'

gem 'html-proofer', '~> 3.19'
gem 'tzinfo-data', platforms: [:mingw, :mswin, :x64_mingw]
